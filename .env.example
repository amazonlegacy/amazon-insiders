# Stripe — récupère tes clés sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Webhook secret — obtenu avec : stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# URL de base de l'application (en production, remplace par ton domaine)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
